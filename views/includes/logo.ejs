<% const variant = typeof logoVariant !== "undefined" ? logoVariant : "nav"; %>
<% if (variant === "footer") { %>
<svg class="footer-logo" xmlns="http://www.w3.org/2000/svg" width="900" height="220" viewBox="0 0 900 220" role="img" aria-label="eazyinvites — Stays Made Simple">
  <g transform="translate(34 43) scale(1.05)">
    <path class="logo-mark-sand" d="M10 55 52 14 86 48 86 110 10 110Z M47 108V65L64 49L81 65V108Z" fill-rule="evenodd" />
    <path class="logo-mark-earth" d="M53 55 91 17 120 47 120 110 53 110Z M47 108V65L64 49L81 65V108Z" fill-rule="evenodd" />
  </g>
  <g font-family="'Space Grotesk', sans-serif" font-weight="600">
    <text x="205" y="119" font-size="72" letter-spacing="-1.9" textLength="500" lengthAdjust="spacingAndGlyphs"><tspan class="logo-eazy">eazy</tspan><tspan class="logo-invites">invites</tspan></text>
  </g>
  <text class="logo-tagline" x="455" y="158" text-anchor="middle" font-family="'DM Sans', sans-serif" font-size="13" letter-spacing="5.1">STAYS MADE SIMPLE</text>
</svg>
<% } else { %>
<svg class="brand-logo" xmlns="http://www.w3.org/2000/svg" width="700" height="150" viewBox="0 0 700 150" role="img" aria-label="eazyinvites">
  <g transform="translate(20 11) scale(1.05)">
    <path class="logo-mark-sand" d="M10 55 52 14 86 48 86 110 10 110Z M47 108V65L64 49L81 65V108Z" fill-rule="evenodd" />
    <path class="logo-mark-earth" d="M53 55 91 17 120 47 120 110 53 110Z M47 108V65L64 49L81 65V108Z" fill-rule="evenodd" />
  </g>
  <g font-family="'Space Grotesk', sans-serif" font-weight="600">
    <text x="175" y="91" font-size="56" letter-spacing="-1.2" textLength="390" lengthAdjust="spacingAndGlyphs"><tspan class="logo-eazy">eazy</tspan><tspan class="logo-invites">invites</tspan></text>
  </g>
</svg>
<% } %>
