<% const variant = typeof logoVariant !== "undefined" ? logoVariant : "nav"; %>
<% if (variant === "footer") { %>
<svg class="footer-logo" xmlns="http://www.w3.org/2000/svg" width="900" height="220" viewBox="0 0 900 220" role="img" aria-label="EasyInvites — Stays Made Simple">
  <g transform="translate(34 43) scale(1.05)">
    <path class="logo-mark-sand" d="M10 55 52 14 86 48 86 110 10 110Z M47 108V65L64 49L81 65V108Z" fill-rule="evenodd" />
    <path class="logo-mark-earth" d="M53 55 91 17 120 47 120 110 53 110Z M47 108V65L64 49L81 65V108Z" fill-rule="evenodd" />
  </g>
  <g font-family="'Space Grotesk', sans-serif" font-weight="600">
    <text class="logo-easy" x="205" y="119" font-size="72" letter-spacing="-2.8" textLength="164" lengthAdjust="spacingAndGlyphs">Easy</text>
    <text class="logo-invites" x="365" y="119" font-size="72" letter-spacing="-2.8" textLength="270" lengthAdjust="spacingAndGlyphs">Invites</text>
  </g>
  <text class="logo-tagline" x="209" y="158" font-family="'DM Sans', sans-serif" font-size="13" letter-spacing="5.1">STAYS MADE SIMPLE</text>
</svg>
<% } else { %>
<svg class="brand-logo" xmlns="http://www.w3.org/2000/svg" width="700" height="150" viewBox="0 0 700 150" role="img" aria-label="EasyInvites">
  <g transform="translate(20 11) scale(1.05)">
    <path class="logo-mark-sand" d="M10 55 52 14 86 48 86 110 10 110Z M47 108V65L64 49L81 65V108Z" fill-rule="evenodd" />
    <path class="logo-mark-earth" d="M53 55 91 17 120 47 120 110 53 110Z M47 108V65L64 49L81 65V108Z" fill-rule="evenodd" />
  </g>
  <g font-family="'Space Grotesk', sans-serif" font-weight="600">
    <text class="logo-easy" x="175" y="91" font-size="62" letter-spacing="-2.1" textLength="142" lengthAdjust="spacingAndGlyphs">Easy</text>
    <text class="logo-invites" x="314" y="91" font-size="62" letter-spacing="-2.1" textLength="232" lengthAdjust="spacingAndGlyphs">Invites</text>
  </g>
</svg>
<% } %>
