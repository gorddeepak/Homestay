<footer class="homestay-footer">
  <div class="container">
    <div class="row g-5">
      <div class="col-12 col-lg-5">
        <a href="/" class="footer-brand-link" aria-label="EazyInvites home">
          <img src="/brand/eazyinvite-lockup-stays-hotels.svg" alt="EazyInvites — stays and hotels" class="footer-logo" width="1343" height="273">
        </a>
        <p class="footer-blurb mt-4">
          Thoughtfully chosen homes for travellers who care how a place feels.
          Every stay is picked for its setting, its character, and the welcome
          that awaits.
        </p>
        <p class="footer-kicker"><span></span> Curated stays, not listings</p>
      </div>

      <div class="col-6 col-lg-2 offset-lg-1">
        <h4 class="footer-heading">Explore</h4>
        <ul class="footer-links list-unstyled">
          <li class="mb-3"><a href="/listings">All stays</a></li>
          <li class="mb-3"><a href="/listings">Coastal havens</a></li>
          <li class="mb-3"><a href="/listings">Mountain escapes</a></li>
          <li class="mb-3"><a href="/listings">Heritage homestays</a></li>
        </ul>
      </div>

      <div class="col-6 col-lg-2">
        <h4 class="footer-heading">Hosting</h4>
        <ul class="footer-links list-unstyled">
          <li class="mb-3"><a href="/listings/new">List your home</a></li>
          <li class="mb-3"><a href="/listings/new">Become a host</a></li>
          <% if (currUser) { %>
          <li class="mb-3"><a href="/logout">Log out</a></li>
          <% } else { %>
          <li class="mb-3"><a href="/signup">Create an account</a></li>
          <li class="mb-3"><a href="/login">Log in</a></li>
          <% } %>
        </ul>
      </div>

      <div class="col-12 col-lg-2">
        <h4 class="footer-heading">Mira</h4>
        <p class="footer-blurb footer-blurb-sm">
          Looking for a quiet coast or a mountain hideout? Mira, our AI
          concierge, knows every stay.
        </p>
        <button type="button" class="footer-chat-btn" id="footerChatBtn">
          <i class="bi bi-stars"></i> Ask Mira
        </button>
      </div>
    </div>

    <div class="footer-bottom d-flex justify-content-between align-items-center flex-wrap gap-3">
      <span>&copy; <%= new Date().getFullYear() %> EazyInvites. All rights reserved.</span>
      <span class="footer-tagline">Stays &amp; hotels, thoughtfully curated</span>
    </div>
  </div>
</footer>
