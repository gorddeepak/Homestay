# Runtime environment: "development" (default) or "production".
# Set to "production" in every deployment. Production requires explicit
# https:// origins below, always uses Secure auth cookies, and refuses to start
# when either requirement is not met.
ENVIRONMENT=development

# MongoDB connection string. Include the database name in the path.
# Local development database used by the existing Express application:
ATLAS_DB_URL=mongodb://127.0.0.1:27017/homestay

# Atlas example (never commit real credentials):
# ATLAS_DB_URL=mongodb+srv://<user>:<password>@<cluster>/<database>

# Secret used to sign FastAPI authentication cookies. At least 32 characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=

# Development only: set to true when the API is served over HTTPS.
# Production ignores this value and always uses Secure cookies.
AUTH_COOKIE_SECURE=false

# Browser origins allowed to make state-changing authentication requests.
# Development falls back to the Vite dev server. Production must list every
# real https:// origin explicitly, for example:
#   AUTH_ALLOWED_ORIGINS=https://eazyinvites.in
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary image uploads. These are the same variables the Express app uses.
# Server-side secrets only; never expose them to the browser or Vite.
# Without them, POST /api/uploads returns 502 and new listings cannot be created.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# MapTiler key used for server-side geocoding and for the browser map style.
# This is the one provider key the browser needs: GET /api/config returns it.
# MapTiler browser keys are public by design, so restrict them by origin in the
# MapTiler dashboard and never use a secret key here.
MAPTILER_API_KEY=

# Gemini API key used by the FastAPI AI features. This key is server-side only
# and is never returned to the browser. The Express app keeps its own copy.
GEMINI_API_KEY=

# One Gemini model for both AI features. gemini-3.5-flash-lite is the current
# stable, cost-efficient model for short text generation and structured output.
GEMINI_MODEL=gemini-3.5-flash-lite

# Per-request timeout in seconds for Gemini calls (allowed range: 1-120).
# Mira can take 15-25 seconds on a cold request, so keep this comfortably above
# the expected provider latency.
GEMINI_TIMEOUT_SECONDS=45

